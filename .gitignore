# =============================================================================
# .gitignore — Explainable Multimodal Quantum-GNN CXR Diagnosis
# =============================================================================

# --- Python & Environments ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
all_test_output.txt
audit_output.txt
test_output.txt

# --- Datasets & Raw Cache (Keep splits tracked, ignore raw downloads) ---
data/raw/
*.arrow
*.parquet
*.csv.gz
*.tar
*.tar.gz
*.zip

# --- Model Checkpoints & Weights ---
checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.onnx

# --- Outputs, Logs & Experiment Runs ---
outputs/
logs/
results/
runs/
wandb/
*.log

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- IDEs & OS Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# --- Scratch & Temporary Debug ---
scratch/

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example